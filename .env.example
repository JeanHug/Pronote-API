# =============================================================================
# Variables d'environnement — Pronote API
# =============================================================================
#
# ⚠️  CE FICHIER EST UN MODÈLE. Ne mettez JAMAIS de valeur réelle dedans : il est
#     versionné et public.
#
# Les secrets ne se configurent PAS ici, mais à deux endroits :
#
#   1. Worker Cloudflare  →  wrangler secret put NOM
#      (ou automatiquement par .github/workflows/deploy-worker.yml)
#
#   2. Runner GitHub Actions  →  Settings → Secrets and variables → Actions
#
# Ce fichier ne sert qu'à lancer le projet EN LOCAL.
# =============================================================================

# -----------------------------------------------------------------------------
# Identifiants ENT — UNIQUEMENT pour tester en local
# -----------------------------------------------------------------------------
# N'utilisez pas les identifiants d'un élève réel dans un fichier plat non
# chiffré. Pour tout usage réel, passez par les secrets GitHub Actions, qui
# restent confinés à l'environnement du runner.
ENT_ID=
ENT_PASS=

# -----------------------------------------------------------------------------
# Cloudflare (déploiement du Worker)
# -----------------------------------------------------------------------------
# CLOUDFLARE_TOKEN : jeton API avec la permission « Workers Scripts: Edit »
#                    et « Workers KV / Durable Objects: Edit ».
# CLOUDFLARE_ID    : identifiant du compte Cloudflare (Account ID).
#
# En local, `wrangler dev` lit ces variables ; en CI, elles viennent des
# secrets du dépôt.
CLOUDFLARE_TOKEN=
CLOUDFLARE_ID=

# -----------------------------------------------------------------------------
# Secrets du Worker (à définir avec `wrangler secret put`)
# -----------------------------------------------------------------------------
# GITHUB_TOKEN     : PAT permettant au Worker de déclencher le runner Actions.
#                    Portée minimale nécessaire : « Actions: write ».
# RUNNER_TOKEN     : secret PARTAGÉ entre le Worker et le runner. Il authentifie
#                    les endpoints /api/v1/runner/*. Sans lui, ces endpoints
#                    refusent tout (fail-closed).
#                    Si vous ne le définissez pas, GH_TOKEN sert de repli.
RUNNER_TOKEN=

# API_KEYS         : liste de clés d'API séparées par des virgules, pour
#                    restreindre l'accès à /api/v1/scrape-pronote.
#                    Vide = accès libre (à éviter en production).
API_KEYS=

# -----------------------------------------------------------------------------
# Configuration non sensible
# -----------------------------------------------------------------------------
# Origines autorisées en Cross-Origin. Vide = même origine uniquement.
# NE JAMAIS mettre « * » : les réponses contiennent les notes d'un élève.
ALLOWED_ORIGINS=

# Domaines acceptés pour pronoteUrl et entUrl (protection SSRF).
# Vide = tout domaine public HTTPS, hors adresses réseau internes.
ALLOWED_HOST_SUFFIXES=index-education.net,ent.seine-et-marne.fr

# Budget d'attente synchrone avant bascule en réponse 202 + jobId (ms).
SYNC_WAIT_MS=25000

# Établissement et ENT par défaut, si l'appelant n'en fournit pas.
PRONOTE_URL=https://0771068t.index-education.net/pronote/eleve.html
ENT_URL=https://ent.seine-et-marne.fr/

# URL du Worker, utilisée par le runner et par les scripts de test.
WORKER_URL=https://pronote-api.hugdu77777.workers.dev
API_BASE=https://pronote-api.hugdu77777.workers.dev
